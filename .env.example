# Salin file ini menjadi .env di server produksi sebelum menjalankan Docker Compose.
# Nilai PORT dan DATABASE_URL juga disetel oleh docker-compose.production.yml.
NODE_ENV=production
PORT=3300
DATABASE_URL=/app/data/sqlite.db
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=webkelas-submissions
RUSTFS_ACCESS_KEY_ID=isi_access_key_rustfs
RUSTFS_SECRET_ACCESS_KEY=isi_secret_key_rustfs
RUSTFS_FORCE_PATH_STYLE=true
